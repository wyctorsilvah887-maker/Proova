{
  "entities": {
    "User": {
      "title": "User",
      "description": "Perfil de usuário unificado (Lead ou Admin).",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "companyName": { "type": "string" },
        "companySlug": { "type": "string", "description": "Link único global para /c/ e /pp/." },
        "email": { "type": "string", "format": "email" },
        "businessType": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "googleMapsUrl": { "type": "string" },
        "googlePlaceId": { "type": "string" },
        "isAdmin": { "type": "boolean" },
        "membershipStatus": { "type": "string" },
        "isSetupProcessDone": { "type": "boolean" },
        "googleConnected": { "type": "boolean", "description": "Indica se o usuário autorizou o Proova a gerenciar seu GBP." },
        "lastGoogleSync": { "type": "string", "format": "date-time" },
        "fcmToken": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "SupportMessage": {
      "title": "Support Message",
      "description": "Mensagem de suporte trocada via chat.",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "sender": { "type": "string", "enum": ["user", "support"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Slug": {
      "title": "Global Slug Registry",
      "description": "Garante que URLs personalizadas sejam únicas.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["account", "pp"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/slugs/{slug}": {
      "schema": "Slug"
    },
    "/users/{userId}": {
      "schema": "User"
    }
  }
}
