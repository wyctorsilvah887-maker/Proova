
{
  "entities": {
    "User": {
      "title": "User",
      "description": "Perfil de usuário unificado (Lead ou Admin).",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "companyName": { "type": "string" },
        "companySlug": { "type": "string", "description": "Link único global para /c/ e /pp/." },
        "email": { "type": "string", "format": "email" },
        "businessType": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "googleMapsUrl": { "type": "string" },
        "googlePlaceId": { "type": "string" },
        "isAdmin": { "type": "boolean" },
        "membershipStatus": { "type": "string" },
        "isSetupProcessDone": { "type": "boolean", "description": "Indica se o usuário já completou o checklist de onboarding pelo menos uma vez." },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Slug": {
      "title": "Global Slug Registry",
      "description": "Garante que URLs personalizadas sejam únicas em toda a plataforma.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["account", "pp"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "PublicPage": {
      "title": "PublicPage Configuration",
      "description": "Configurações exclusivas da Landing Page do usuário.",
      "type": "object",
      "properties": {
        "themeColor": { "type": "string" },
        "heroTitle": { "type": "string" },
        "selectedTestimonialIds": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "firestore": {
    "/slugs/{slug}": {
      "schema": "Slug",
      "description": "Cartório global de slugs únicos."
    },
    "/users/{userId}/pp/{slug}": {
      "schema": "PublicPage",
      "description": "Configuração da Página Pública independente de widgets."
    }
  }
}
