rules_version = '2';

// Regras de Segurança do Firebase Storage - Versão 2.3
// Permite uploads de depoimentos em vídeo pelo público e uploads administrativos de widgets.

service firebase.storage {
  match /b/{bucket}/o {
    
    // Caminho para vídeos de depoimento enviados por consumidores (Público)
    match /users/{userId}/testimonials_videos/{fileName} {
      allow read: if true;
      // Permite o upload de arquivos de até 100MB para evitar abusos
      allow create: if request.resource.size < 100 * 1024 * 1024;
    }

    // Caminho: users/{userId}/widgets/{widgetId}/{fileName}
    match /users/{userId}/widgets/{widgetId}/{allPaths=**} {
      
      // Permite leitura pública para exibição nos widgets e landing pages
      allow read: if true;
      
      // Permite escrita se o usuário estiver autenticado e o UID bater com o segmento da pasta
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Bloqueio padrão para segurança
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
