rules_version = '2';

// Regras de Segurança do Firebase Storage - Proova
// Permite que consumidores enviem depoimentos em vídeo e administradores gerenciem seus widgets.

service firebase.storage {
  match /b/{bucket}/o {
    
    // 1. Depoimentos em Vídeo (Público)
    // Precisamos permitir 'read', 'create' e 'update' para que o upload anônimo funcione via SDK
    match /users/{userId}/testimonials_videos/{fileName} {
      allow read, create, update: if true;
      // Nota: A restrição de tamanho é aplicada via código no cliente, 
      // mas mantemos as regras abertas para garantir a conclusão do handshake do upload.
    }

    // 2. Recursos de Widgets e Logos (Híbrido)
    match /users/{userId}/widgets/{widgetId}/{allPaths=**} {
      // Leitura é pública para exibição nos sites
      allow read: if true;
      
      // Escrita apenas pelo proprietário autenticado
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // 3. Proteção Padrão
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}