rules_version = '2';

// Regras de Segurança do Firebase Storage - Proova
// Permite que consumidores enviem mídia pública e administradores gerenciem recursos da conta.

service firebase.storage {
  match /b/{bucket}/o {
    
    // 1. Depoimentos em Vídeo e Foto (Público)
    // 'update' é necessário para o handshake de upload do SDK do Firebase.
    match /users/{userId}/testimonials_videos/{fileName} {
      allow read, create, update: if true;
    }
    
    match /users/{userId}/testimonials_photos/{fileName} {
      allow read, create, update: if true;
    }

    // 2. Recursos de Conta, Widgets, Logos e Página Pública (Proprietário)
    // Permitimos leitura pública para que os logos apareçam nos sites.
    // A escrita é restrita apenas ao dono da conta autenticado.
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // 3. Bloqueio padrão para segurança
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}