rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regras para a coleção de avisos globais
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Regras para Slugs Globais (Cartório de Nomes)
    // Permite que qualquer pessoa verifique se um slug existe, mas apenas usuários logados reservem nomes.
    match /slugs/{slug} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && 
        (resource == null || resource.data.userId == request.auth.uid);
    }

    // Regras para Rate Limiting
    match /rate_limits/{limitId} {
      allow create, list: if true;
    }

    // Regras para Estatísticas de Conversão (Rastreamento de LP)
    match /platform_stats/{statsId} {
      allow read: if true;
      allow write: if true; 
    }

    // Regras para a coleção de usuários e subcoleções
    match /users/{userId} {
      allow create: if true;
      allow get, list: if true;
      
      allow update: if (request.auth != null && request.auth.uid == userId) || 
        (request.resource.data.diff(resource.data).affectedKeys().hasAny(['testimonialsCount', 'googleRedirectCount', 'membershipStatus', 'trialUsed', 'trialStartedAt']));
      
      allow delete: if request.auth != null && request.auth.uid == userId;
      
      // Página Pública Independente (Subcoleção)
      // Leitura é pública para que os visitantes acessem a PP. Escrita apenas pelo dono.
      match /pp/{slug} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Depoimentos Públicos (Fila de Curadoria e Mural)
      match /testimonials/{testimonialId} {
        allow create, read: if true; 
        allow update, delete: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
      }

      // Feedbacks Privados (Inbox)
      match /private_feedbacks/{feedbackId} {
        allow create: if true;
        allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      }

      // Configurações de Widgets
      match /widgets/{widgetId} {
        allow read: if true;
        allow update, create, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Regras para Logs de Pagamento
    match /payment_events/{eventId} {
      allow create: if true;
      allow read: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // Regra Mestra para Administradores
    match /{document=**} {
      allow read, write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
  }
}