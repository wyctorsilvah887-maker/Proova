
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regras para a coleção de avisos globais
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Regras para Tickets de Suporte Global
    match /support_tickets/{ticketId} {
      allow create: if request.auth != null;
      // Permissão para listar baseada no campo userId do documento
      allow read, list: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      );
      // Atualização permitida para o dono (marcar presença) ou administradores
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      );
      // Deleção permitida para o dono (encerrar chat) ou administradores
      allow delete: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
      );
    }

    // Regras para Slugs Globais (Cartório de Nomes)
    match /slugs/{slug} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && 
        (resource == null || resource.data.userId == request.auth.uid);
    }

    // Regras para Rate Limiting
    match /rate_limits/{limitId} {
      allow create, list: if true;
    }

    // Regras para Estatísticas de Conversão
    match /platform_stats/{statsId} {
      allow read, write: if true; 
    }

    // Regras para a coleção de usuários e subcoleções
    match /users/{userId} {
      allow get, list: if true;
      allow create: if true;
      
      allow update: if (request.auth != null && request.auth.uid == userId) || 
        (request.resource.data.diff(resource.data).affectedKeys().hasAny(['testimonialsCount', 'googleRedirectCount', 'membershipStatus', 'trialUsed', 'trialStartedAt', 'ppVisitCount', 'whatsappClickCount']));
      
      allow delete: if request.auth != null && request.auth.uid == userId;
      
      // Suporte Técnico (Chat)
      match /support_messages/{messageId} {
        allow read, create, delete: if request.auth != null && (
          request.auth.uid == userId ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
        );
      }

      // Página Pública (PP)
      match /pp/{slug} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      // Depoimentos Públicos (Abertos para leitura de widgets externos)
      match /testimonials/{testimonialId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
      }

      // Feedbacks Privados (Inbox)
      match /private_feedbacks/{feedbackId} {
        allow create: if true;
        allow read, update, delete: if request.auth != null && request.auth.uid == userId;
      }

      // Configurações de Widgets (Abertos para leitura do script oficial)
      match /widgets/{widgetId} {
        allow read: if true;
        allow update, create, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Regras para Logs de Pagamento
    match /payment_events/{eventId} {
      allow create: if true;
      allow read: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    
    // Suporte para Collection Group
    match /{path=**}/testimonials/{testimonial} {
      allow read: if true;
    }
    match /{path=**}/widgets/{widget} {
      allow read: if true;
    }

    // Regra Mestra para Administradores
    match /{document=**} {
      allow read, write: if request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
  }
}
